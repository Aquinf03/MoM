# Local paths / secrets for model weights and API keys (never commit .env).

# Directory of on-disk weights (ignored by git)
MOM_WEIGHTS_DIR=./weights

# Optional remote backends behind the same adapter contract
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Prefer colocated / local inference for v1 latency work
MOM_PREFER_LOCAL=1
