# Local paths / secrets (never commit .env)

# Primary: in-process models from Hugging Face Hub OR filesystem paths
MOM_BACKEND=local
MOM_WEIGHTS_DIR=./weights
MOM_DEVICE=auto
MOM_DTYPE=auto
MOM_MAX_NEW_TOKENS=256

# Hub id (org/name) OR path to a transformers-compatible directory
MOM_CHAT_FAST=HuggingFaceTB/SmolLM2-135M-Instruct
MOM_CHAT_STRONG=HuggingFaceTB/SmolLM2-360M-Instruct
MOM_EMBED=sentence-transformers/all-MiniLM-L6-v2
MOM_VISION_CAPTION=Salesforce/blip-image-captioning-base
MOM_VISION_TORCH=resnet18
# MOM_ROUTER=           # optional Hub id/path; empty = heuristic router
# MOM_HF_REVISION=
# HF_TOKEN=             # only if the Hub repo is gated

# Optional HTTP backend (external APIs) — set MOM_BACKEND=http
# MOM_BACKEND=http
# MOM_PREFER_LOCAL=0
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Serving
MOM_HOST=0.0.0.0
MOM_PORT=8080
MOM_MAX_RUNS=32
MOM_MAX_MODEL_WORKERS=64
MOM_ACQUIRE_TIMEOUT_S=5
MOM_DEFAULT_GRAPH=speculate_chat
MOM_INCLUDE_STUBS=0
MOM_LOG_LEVEL=INFO
MOM_LOG_JSON=0
MOM_HTTP_TIMEOUT_S=60
MOM_HTTP_CONNECT_TIMEOUT_S=10
MOM_HTTP_MAX_RETRIES=2
