# Local paths / secrets (never commit .env)

# Weights / local artifacts
MOM_WEIGHTS_DIR=./weights

# Prefer colocated OpenAI-compatible server (Ollama / vLLM) for latency work
MOM_PREFER_LOCAL=1
MOM_LOCAL_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
MOM_LOCAL_OPENAI_API_KEY=ollama
MOM_LOCAL_CHAT_MODEL=llama3.2
MOM_LOCAL_EMBED_MODEL=nomic-embed-text

# Cloud backends (optional; used when MOM_PREFER_LOCAL=0 or for Anthropic strong path)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# HTTP
MOM_HTTP_TIMEOUT_S=60
MOM_HTTP_CONNECT_TIMEOUT_S=10
MOM_HTTP_MAX_RETRIES=2

# Serving
MOM_HOST=0.0.0.0
MOM_PORT=8080
MOM_MAX_RUNS=32
MOM_MAX_MODEL_WORKERS=64
MOM_ACQUIRE_TIMEOUT_S=5
MOM_DEFAULT_GRAPH=speculate_chat
MOM_INCLUDE_STUBS=0
MOM_LOG_LEVEL=INFO
MOM_LOG_JSON=0
